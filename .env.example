# Project Mesh - Environment Variables
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://meshuser:meshpassword@localhost:5432/projectmesh"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Optional: Upload storage (future)
# UPLOAD_BUCKET=""
# UPLOAD_REGION=""
